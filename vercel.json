{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "auth": {
      "root": "apps/auth",
      "framework": "react-router"
    },
    "desktop": {
      "root": "apps/desktop",
      "framework": "vite"
    },
    "share": {
      "root": "apps/share",
      "framework": "react-router"
    },
    "workbench": {
      "root": "apps/workbench",
      "framework": "react-router"
    },
    "openapi": {
      "root": "packages/openapi",
      "framework": "hono"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
